// Virtuascope VCS — Postgres domain metadata (MVP)
// Source of truth for VCS-001 persistence shape.
//
// LLM settings (prompt / model / temperature) are NOT in Postgres.
// They live in backend config and are loaded in-process by RAG (VCS-008).
// Embeddings: pgvector in the same Postgres instance (resolved).
// Table chunk_embeddings holds vectors; chunks.vector_id points at the store.

Enum tenant_status {
  active
  suspended
}

Enum membership_role {
  owner
  admin
  member
}

Enum bot_status {
  draft
  live
  disabled
}

Enum source_status {
  processing
  ready
  failed
}

Enum conversation_channel {
  playground
  // host / embed → P2
}

Enum message_role {
  user
  assistant
}

Table tenants {
  id uuid [pk]
  name varchar [not null]
  slug varchar [unique, not null]
  status tenant_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id uuid [pk]
  email varchar [unique, not null]
  name varchar [not null]
  password_hash varchar // self-hosted JWT (VCS-002); managed IdP deferred
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table memberships {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  user_id uuid [not null, ref: > users.id]
  role membership_role [not null, default: 'member']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, user_id) [unique]
    tenant_id
    user_id
  }
}

// Metadata only — no system_prompt / model / temperature columns
Table bots {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar [not null]
  status bot_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    (tenant_id, id) [unique]
  }
}

Table sources {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  bot_id uuid [not null, ref: > bots.id]

  filename varchar [not null]
  content_type varchar [not null]
  byte_size bigint
  storage_key varchar [not null] // object storage path
  status source_status [not null, default: 'processing']
  error_message text

  created_by_user_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, bot_id)
    (bot_id, status)
  }
}

Table chunks {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  bot_id uuid [not null, ref: > bots.id]
  source_id uuid [not null, ref: > sources.id]

  ordinal int [not null]
  content text [not null]
  token_count int
  vector_id varchar // pointer into chunk_embeddings (e.g. embedding row id); null until indexed
  metadata jsonb [default: '{}']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, bot_id)
    source_id
    (source_id, ordinal) [unique]
    vector_id
  }
}

// pgvector storage (same DB). FK chunk_id → chunks.id deferred until chunks table exists.
Table chunk_embeddings {
  id uuid [pk]
  chunk_id uuid [unique, not null] // joins to chunks.id (FK later)
  tenant_id uuid [not null]
  bot_id uuid [not null]
  embedding vector [not null] // vector(1536) — must match EMBEDDING_DIMENSION
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, bot_id)
    // HNSW on embedding (vector_cosine_ops) — created in Alembic
  }
}

Table conversations {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  bot_id uuid [not null, ref: > bots.id]
  user_id uuid [ref: > users.id]
  channel conversation_channel [not null, default: 'playground']
  title varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, bot_id)
    (bot_id, user_id)
  }
}

Table messages {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  bot_id uuid [not null, ref: > bots.id]
  conversation_id uuid [not null, ref: > conversations.id]

  role message_role [not null]
  content text [not null]
  citations jsonb // optional [{source_id, chunk_id, score?}, ...]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    conversation_id
    (tenant_id, bot_id)
  }
}
